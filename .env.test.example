# --- Test DB (compose project autoapply-test, host port 5435) ---
# Copy this to .env.test to override; .env.test itself is gitignored.
TEST_POSTGRES_USER=autoapply
TEST_POSTGRES_PASSWORD=autoapply
TEST_POSTGRES_DB=autoapply
TEST_POSTGRES_PORT=5435

# App runtime against the TEST cluster: app_user (RLS subject). NEVER admin in the app.
DATABASE_URL=postgresql://app_user:changeme_in_production@localhost:5435/autoapply
# Migrations/parity admin on the TEST cluster (needs CREATEDB for harness tests).
MIGRATE_DATABASE_URL=postgresql://autoapply:autoapply@localhost:5435/autoapply

# --- pgAdmin (test stack UI; reachable at http://localhost:5050) ---
PGADMIN_DEFAULT_EMAIL=admin@autoapply.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- LLM at-rest encryption (S4/D18) ---
LLM_PROVIDER_MASTER_KEY=0123456789abcdef0123456789abcdef
