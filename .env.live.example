# Live LLM provider smoke-test keys - OPTIONAL, on-demand only.
#
# Copy this file to `.env.live` (gitignored) and paste REAL API keys into the
# placeholders. The live suite only runs when you explicitly call:
#
#     .\tasks.ps1 -Target test-integration-live
#
# That target sets RUN_LIVE_LLM=1. Placeholder values below are treated as
# "not configured" by the tests and simply skipped. No live test ever runs from
# the normal gates (test-integration / lint / parity).

RUN_LIVE_LLM=1

# Browser render gate for the Door-3.5 escalation (D35/D39): truthy -> jd_fetch_browser
# may launch real Chromium. Off by default; required by tests/live/test_jd_render_live.py.
JD_RENDER_AVAILABLE=1

# Cloud provider keys (at least one is required for the live suite to run).
LIVE_GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
LIVE_GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
LIVE_OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY_HERE

# Optional: local Ollama smoke test (no key required).
# Unset/blank to skip Ollama. Point it at your running local Ollama.
LIVE_OLLAMA_URL=http://localhost:11434

# S6 JD extractor — real posting URLs (D29).
# JD_SMOKE_URL overrides the CI network_smoke default; LIVE_ATS_URL is a
# comma-separated list of real postings for tests/live/test_jd_extractor_live.py;
# LIVE_RENDER_URL is a JS-shell posting (React #root mount, e.g. Ashby boards —
# verified 2026-09-14: raw httpx = 0 chars text, Chromium renders the job) →
# blank/failing page → render test skips. No LLM keys needed for the render test.
JD_SMOKE_URL=https://boards.greenhouse.io/greenhouse
LIVE_ATS_URL=https://stackbinary.io/careers/ai-engineering-intern,https://www.amazon.jobs/en/jobs/3134242/associate-ml-data-operations-go-ai-operations
LIVE_RENDER_URL=https://jobs.ashbyhq.com/ashby/6a15668c-3f98-4404-8f1f-927cddfc5af7
