# --- Postgres ---
POSTGRES_USER=autoapply
POSTGRES_PASSWORD=autoapply
POSTGRES_DB=autoapply

# --- Database URLs ---
# App runtime: app_user (RLS subject). NEVER admin in the app.
DATABASE_URL=postgresql://app_user:changeme_in_production@localhost:5432/autoapply
# Migrations/parity: compose superuser (needs CREATEDB for harness tests).
MIGRATE_DATABASE_URL=postgresql://autoapply:autoapply@localhost:5432/autoapply

# --- App ---
APP_SECRET=
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- LLM providers (S4) ---
LLM_PROVIDER_GEMINI_KEY=
LLM_PROVIDER_GROQ_KEY=
LLM_PROVIDER_OPENROUTER_KEY=

# --- Discovery (S12/S13) ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# --- MCP (S17) ---
MCP_API_KEY=