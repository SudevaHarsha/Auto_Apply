    {
      "name": "7. Second user — RLS data scoping (D8/D10 proof at HTTP)",
      "description": "Registers a distinct identity and proves the Bearer token binds data to its own subject only: me/settings return B's data under B's token, never A's.",
      "item": [
        {
          "name": "7.1 Register second user (fresh pair for B)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{secondUserEmail}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"name\": \"Postman Tester B\"\n}"
            },
            "url": { "raw": "{{baseUrl}}{{apiPrefix}}/auth/register", "host": ["{{baseUrl}}"], "path": ["{{apiPrefix}}", "auth", "register"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = 'pm.b.' + Date.now() + '@example.com';",
                  "pm.collectionVariables.set('secondUserEmail', email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('B tokens stored separately', () => {",
                  "  pm.collectionVariables.set('secondUserAccessToken', b.access_token);",
                  "  pm.collectionVariables.set('secondUserRefreshToken', b.refresh_token);",
                  "  pm.expect(b.email).to.eql(pm.collectionVariables.get('secondUserEmail'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "7.2 me as B returns B (RLS binding: sub -> B row only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{secondUserAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}{{apiPrefix}}/auth/me", "host": ["{{baseUrl}}"], "path": ["{{apiPrefix}}", "auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('B sees B only (id != A userId), email matches B', () => {",
                  "  pm.expect(b.email).to.eql(pm.collectionVariables.get('secondUserEmail'));",
                  "  pm.expect(b.id).to.not.eql(pm.collectionVariables.get('userId'));",
                  "  pm.expect(b.name).to.eql('Postman Tester B');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "7.3 B's settings are fresh defaults (A's §17 overrides invisible)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{secondUserAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}{{apiPrefix}}/auth/settings", "host": ["{{baseUrl}}"], "path": ["{{apiPrefix}}", "auth", "settings"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('B never sees A: theme dark (A set light), notifications true (A set false)', () => {",
                  "  pm.expect(b.theme).to.eql('dark');",
