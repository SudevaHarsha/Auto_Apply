                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('CLASSIFICATION == UPDATED: updated_at moved, created_at untouched', () => {",
                  "  pm.expect(b.phone).to.eql('+1 555 0199');",
                  "  pm.expect(b.city).to.eql('Portland');                    // untouched field persisted",
                  "  const created = new Date(pm.collectionVariables.get('profileCreatedAt')).getTime();",
                  "  const updated = new Date(b.updated_at).getTime();",
