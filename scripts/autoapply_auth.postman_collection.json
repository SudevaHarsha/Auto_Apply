            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+1 555 0100\",\n  \"city\": \"Portland\",\n  \"linkedin_url\": \"https://linkedin.com/in/testera\",\n  \"custom_fields\": {\"target_role\": \"backend\"}\n}"
            },
            "url": { "raw": "{{baseUrl}}{{apiPrefix}}/auth/user-profile", "host": ["{{baseUrl}}"], "path": ["{{apiPrefix}}", "auth", "user-profile"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ok (upsert)', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('whitelisted fields stored + custom_fields dict kept', () => {",
                  "  pm.expect(b.phone).to.eql('+1 555 0100');",
                  "  pm.expect(b.city).to.eql('Portland');",
                  "  pm.expect(b.custom_fields.target_role).to.eql('backend');",
                  "  pm.expect(b.user_id).to.eql(pm.collectionVariables.get('userId'));",
                  "});",
                  "pm.test('CLASSIFICATION == CREATED (created_at == updated_at)', () => {",
                  "  const d1 = new Date(b.created_at).getTime(), d2 = new Date(b.updated_at).getTime();",
                  "  pm.expect(Math.abs(d2 - d1)).to.be.below(2000);",
                  "  pm.collectionVariables.set('profileCreatedAt', b.created_at);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
